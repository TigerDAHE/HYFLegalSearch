# 服务配置
HOST=127.0.0.1
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# LLM 配置（通过 LiteLLM 统一路由，可按需切换模型）
# 例如: openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-20241022, deepseek/deepseek-chat
LLM_MODEL=openai/qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1800
LLM_TIMEOUT_SECONDS=45

# 可选：OpenAI 兼容网关参数（使用时填写）
LLM_API_BASE=""
LLM_API_KEY=""

# Serper 配置（固定使用）
SERPER_API_KEY=""
SERPER_ENDPOINT=https://google.serper.dev/search
SERPER_NUM_RESULTS=5
SERPER_TIMEOUT_SECONDS=20
SERPER_RETRIES=2
SERPER_RETRY_BACKOFF_SECONDS=0.8
SERPER_TRUST_ENV=true
SERPER_MAX_QUERY_LENGTH=180

# 联网触发阈值
SEARCH_COMPLEXITY_THRESHOLD=3
SEARCH_CONFIDENCE_THRESHOLD=0.65

# 抓取配置
FETCH_TIMEOUT_SECONDS=12
MAX_SOURCES_FOR_SYNTHESIS=6
